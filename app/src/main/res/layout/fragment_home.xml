<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 顶栏：左半边告警横幅（弹性宽）+ 右半边搜索栏（固定宽，平板限宽） -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <!-- 左：应用名横幅字（常显）+ 告警横幅列（未授权引导 / 恢复失败，有则叠加其下） -->
        <LinearLayout
            android:id="@+id/banner_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 【P3】列表改由 Compose 渲染（HomeScreen）：四槽卡片 + 动态列数 + 三态 + 滚动暂停预加载。
             原 RecyclerView + GridLayoutManager + GridSpacingDecoration 整段退役 —— 列数判定移到
             Compose 侧由 BoxWithConstraints 实时计算，间距用 LazyGrid 的 spacedBy，无需 ItemDecoration。
             【P6】empty_view 与顶部横幅一并迁进 Compose 后，本布局整体删除。 -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
          【已删除】零服务空态的 View 实现（原 empty_view + ImageView 96dp + empty_title + btn_open_accessibility）。

          删除理由（三重，任一即足够）：
            1) **违反规范**：图标用了 96dp，规范 §8 的空态图形尺寸是 48–56dp（近两倍）；
               且缺规范 §6 要求的「bodyMedium 说明下一步」那一段（`empty_desc` 定义了却无人用）；
            2) **双实现**：Compose 侧已有完整三段式的 `HomeScreen.EmptyState`，
               但被本 View 抢占 —— `updateEmptyState()` 在列表为空时把 ComposeView 设为 GONE，
               于是**写对的那份永远不可达**（缺陷清单模式 10：同功能双实现必须收口单点）；
            3) 属 P6 收尾项（View 残留清零）。

          现由 `HomeScreen` 的 `EmptyState` 独任零服务空态：56dp 低对比图标（SizeTokens.EmptyStateIcon）
          + `titleMedium`「未发现任何无障碍服务」+ `bodyMedium` 下一步 + 主动作。
        -->
    </FrameLayout>
</LinearLayout>
